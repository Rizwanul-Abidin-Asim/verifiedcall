# Copy to .env and fill in. .env is gitignored — never commit real credentials.

# --- CAMARA / Nokia Network-as-Code ---
NOKIA_NAC_API_KEY=
NOKIA_NAC_BASE_URL=

# --- Agent LLM --- (LLM_PROVIDER selects which is used: groq | gemini)
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- Voice ---
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
ELEVENLABS_API_KEY=

# --- Infra (defaults match docker-compose.yml) ---
DATABASE_URL=postgresql+asyncpg://verifiedcall:verifiedcall@localhost:55432/verifiedcall
REDIS_URL=redis://localhost:56379/0

# --- Switches ---
# DEMO_MODE=true forces cached CAMARA fallbacks — the safe path for a live pitch.
DEMO_MODE=false
# VOICE_MOCK=true simulates Vapi outcomes without spending call credits.
VOICE_MOCK=true
APP_ENV=local
